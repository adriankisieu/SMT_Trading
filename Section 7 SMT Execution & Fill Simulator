
# SECTION 7 — SMT EXECUTION & FILL SIMULATOR
# Six independent pairs. Historical simulation only.
# NO broker orders. NO live trading. NO P&L calculation.

from itertools import combinations
import pandas as pd

YAHOO_SYMBOLS = {
    "ES": "ES=F", "NQ": "NQ=F",
    "YM": "YM=F", "RTY": "RTY=F"
}

MICRO_SYMBOLS = {
    "ES": "MES", "NQ": "MNQ",
    "YM": "MYM", "RTY": "M2K"
}

TICK_SIZE = {
    "ES": 0.25, "NQ": 0.25,
    "YM": 1.0, "RTY": 0.10
}

MICRO_MULTIPLIER = {
    "ES": 5.0, "NQ": 2.0,
    "YM": 0.50, "RTY": 5.0
}

ENTRY_SLIPPAGE_TICKS = 1
EXIT_SLIPPAGE_TICKS = 1

# Example cost assumption, not an actual broker quote.
COMMISSION_PER_SIDE = 2.00


# -------------------------------------------------------
# 7A — DOWNLOAD MARKET DATA
# -------------------------------------------------------

def fetch_added_index(symbol, days=45):
    import yfinance as yf

    start = (
        pd.Timestamp.now(tz="America/New_York")
        - pd.Timedelta(days=days)
    ).strftime("%Y-%m-%d")

    frame = yf.download(
        YAHOO_SYMBOLS[symbol],
        interval=CONFIG.interval,
        start=start,
        auto_adjust=False,
        progress=False,
        threads=False,
        multi_level_index=False
    )

    if frame is None or frame.empty:
        raise RuntimeError(f"No Yahoo data for {symbol}")

    if isinstance(frame.columns, pd.MultiIndex):
        frame.columns = frame.columns.get_level_values(0)

    frame.columns = [str(c).lower() for c in frame.columns]
    frame = frame[["open", "high", "low", "close"]].copy()

    if frame.index.tz is None:
        raise ValueError(f"{symbol}: missing timezone")

    frame.index = frame.index.tz_convert("America/New_York")
    frame = frame[~frame.index.duplicated(keep="last")].sort_index()

    cutoff = (
        pd.Timestamp.now(tz="America/New_York")
        - pd.Timedelta(seconds=30)
    )

    return frame[
        frame.index + pd.Timedelta(minutes=5) <= cutoff
    ]


# -------------------------------------------------------
# 7B — IDENTIFY CONFIRMED SIGNALS
# -------------------------------------------------------

def collect_confirmed_signals():
    # Use fixed historical data instead of downloading again.
    prices = {
    symbol: saved_prices[(symbol, "5m")]
    for symbol in ("ES", "NQ", "YM", "RTY")
}

    signals = {}

    for left, right in combinations(YAHOO_SYMBOLS, 2):
        pair = f"{left}/{right}"

        if left not in prices or right not in prices:
            print(f"SKIPPED {pair}: missing data")
            continue

        try:
            df = prepare_data(prices[left], prices[right], CONFIG)
            _, confirmations = scan_signals(df, CONFIG)
        except (ValueError, RuntimeError) as exc:
            print(f"SKIPPED {pair}: {exc}")
            continue

        for c in confirmations:
            leader = left if c.signal.leader == "ES" else right
            side = c.signal.side
            tick = TICK_SIZE[leader]

            direction = 1 if side == "SHORT" else -1

            # Correct the original ES/NQ two-tick stop
            # for the actual leader's tick size.
            stop = c.stop_level + (
                direction * CONFIG.stop_buffer_ticks
                * (tick - 0.25)
            )

            # Normalize to the futures tick grid.
            stop = round(round(stop / tick) * tick, 8)

            key = (c.time, leader, side, stop)

            if key not in signals:
                signals[key] = {
                    "confirmation": c.time,
                    "leader": leader,
                    "contract": MICRO_SYMBOLS[leader],
                    "side": side,
                    "stop": stop,
                    "pairs": [],
                    "bars": prices[leader]
                }

            signals[key]["pairs"].append(pair)

    return sorted(
        signals.values(),
        key=lambda x: x["confirmation"]
    )

confirmed_signals = collect_confirmed_signals()

# -------------------------------------------------------
# 7C — SIMULATE ENTRY AND EXIT FILLS
# -------------------------------------------------------

def simulate_fill(signal):
    bars = signal["bars"]
    confirmation = signal["confirmation"]
    side = signal["side"]
    leader = signal["leader"]

    tick = TICK_SIZE[leader]
    multiplier = MICRO_MULTIPLIER[leader]
    stop = signal["stop"]

    # Confirmation candle is timestamped at OPEN.
    # It closes five minutes later.
    entry_time = confirmation + pd.Timedelta(minutes=5)

    # Reject entries that cannot complete a 30-minute hold by 4 PM.
    session_open = pd.Timestamp("09:30").time()
    last_entry = pd.Timestamp("15:30").time()

    if not session_open <= entry_time.time() <= last_entry:
        return None
    

    if entry_time not in bars.index:
        return None

    if entry_time.date() != confirmation.date():
        return None

    # The market order is assumed to fill at the
    # next candle open with adverse slippage.
    market_open = float(bars.loc[entry_time, "open"])

    if side == "LONG":
        entry = market_open + ENTRY_SLIPPAGE_TICKS * tick
        risk_points = entry - stop
    else:
        entry = market_open - ENTRY_SLIPPAGE_TICKS * tick
        risk_points = stop - entry

    if risk_points <= 0:
        return None

    # Existing risk limit and contract cap.
    risk_budget = CONFIG.initial_paper_equity * CONFIG.paper_risk_fraction
    contracts = int(risk_budget // (risk_points * multiplier))

    if contracts < 1:
        return None

    if side == "LONG":
        target = entry + CONFIG.reward_risk * risk_points
    else:
        target = entry - CONFIG.reward_risk * risk_points

    target = round(round(target / tick) * tick, 8)

    # Check at most 6 candles, including entry candle.
    future = bars.loc[entry_time:]
    future = future[future.index.date == entry_time.date()]
    future = future.head(CONFIG.max_holding_bars)

    if future.empty:
        return None

    exit_time = None
    exit_price = None
    exit_reason = None

    for t, candle in future.iterrows():
        high = float(candle["high"])
        low = float(candle["low"])
        candle_open = float(candle["open"])

        if side == "LONG":
            hit_stop = low <= stop
            hit_target = high >= target
        else:
            hit_stop = high >= stop
            hit_target = low <= target

        if hit_stop:
            exit_time = t
            exit_reason = "STOP"

            # A stop can fill worse than its trigger.
            if side == "LONG":
                raw_exit = min(stop, candle_open)
                exit_price = raw_exit - EXIT_SLIPPAGE_TICKS * tick
            else:
                raw_exit = max(stop, candle_open)
                exit_price = raw_exit + EXIT_SLIPPAGE_TICKS * tick

            break

        if hit_target:
            exit_time = t
            exit_reason = "TARGET"

            # Limit target assumed filled at its limit price.
            # Touching a limit does NOT guarantee a real fill.
            exit_price = target
            break

    if exit_time is None:
        # If fewer than 6 completed candles are available,
        # the exit cannot yet be established.
        if len(future) < CONFIG.max_holding_bars:
            return {
                **signal,
                "entry_time": entry_time,
                "entry": entry,
                "contracts": contracts,
                "target": target,
                "exit_time": None,
                "exit": None,
                "exit_reason": "OPEN / INCOMPLETE"
            }

        last = future.iloc[-1]
        exit_time = future.index[-1]
        exit_reason = "TIME LIMIT"

        if side == "LONG":
            exit_price = (
                float(last["close"])
                - EXIT_SLIPPAGE_TICKS * tick
            )
        else:
            exit_price = (
                float(last["close"])
                + EXIT_SLIPPAGE_TICKS * tick
            )

    return {
        **signal,
        "entry_time": entry_time,
        "entry": round(entry, 8),
        "contracts": contracts,
        "target": target,
        "exit_time": exit_time,
        "exit": round(exit_price, 8),
        "exit_reason": exit_reason
    }


# -------------------------------------------------------
# 7D — DISPLAY SIMULATED FILLS ONLY
# -------------------------------------------------------

def run_execution_simulator():
    signals = confirmed_signals
    simulations = []

    print("========== SMT EXECUTION SIMULATOR ==========")
    print("Historical, hypothetical market-order fills")
    print("No actual orders. No P&L calculated.")
    print(
        f"Entry slippage: {ENTRY_SLIPPAGE_TICKS} tick | "
        f"Stop/time-exit slippage: {EXIT_SLIPPAGE_TICKS} tick"
    )
    print(
        f"Assumed commission: "
        f"${COMMISSION_PER_SIDE:.2f} per contract per side"
    )
    print()

    for signal in signals:
        trade = simulate_fill(signal)

        if trade is None:
            continue

        simulations.append(trade)

        print(
            f"{trade['entry_time']} | "
            f"{trade['side']} {trade['contracts']} "
            f"{trade['contract']}"
        )

        print(
            f"  Simulated entry: {trade['entry']:.2f} | "
            f"Stop: {trade['stop']:.2f} | "
            f"Target: {trade['target']:.2f}"
        )

        if trade["exit"] is None:
            print("  Exit: Not established — insufficient completed data")
        else:
            # Exit timestamp identifies the candle, not
            # the exact intrabar execution time.
            print(
                f"  Simulated exit: {trade['exit']:.2f} | "
                f"{trade['exit_reason']} | "
                f"Exit candle: {trade['exit_time']}"
            )

        print(f"  Signal pair(s): {', '.join(trade['pairs'])}")
        print()

    print("=============================================")
    print(f"Confirmed unique signals: {len(signals)}")
    print(f"Simulated entries: {len(simulations)}")
    print(
        "Unfilled/unavailable simulations: "
        f"{len(signals) - len(simulations)}"
    )

    return simulations


# -------------------------------------------------------
# 7E — RUN
# -------------------------------------------------------

simulated_trades = run_execution_simulator()

