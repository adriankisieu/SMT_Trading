from collections import defaultdict
import pandas as pd
import numpy as np

ORDER_DELAY_MINUTES = 1
ENTRY_SLIPPAGE_TICKS = 1
EXIT_SLIPPAGE_TICKS = 1
ASSUMED_SPREAD_TICKS = 1
COMMISSION_PER_SIDE = 2.00

# Margin is shared by all simultaneously open trades.
MAX_MARGIN_UTILIZATION = 0.50

# BACKTEST ASSUMPTION ONLY, not verified IBKR historical margin.
# Estimated initial margin per micro = 10% of its futures notional value.
# Replace with broker-confirmed margin requirements when available.
ESTIMATED_INITIAL_MARGIN_RATE = 0.10


# -------------------------------------------------------
# 9A — DATA SOURCE
# -------------------------------------------------------
