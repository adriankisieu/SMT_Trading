"""Optional Yahoo historical signal feed. NOT for real-time trading."""
"""This was optimal in the earlier testing but is no longer optimal. DataBento is the main source of data"""
import pandas as pd


def fetch_yahoo(cfg: Config = CONFIG, days: int = 45) -> tuple[pd.DataFrame, pd.DataFrame]:
    import yfinance as yf

    def one(symbol: str) -> pd.DataFrame:
        start_date = (pd.Timestamp.now(tz="America/New_York")
                      - pd.Timedelta(days=days)).strftime("%Y-%m-%d")
        frame = yf.download(symbol, interval=cfg.interval, start=start_date,
                            auto_adjust=False, progress=False, threads=False,
                            multi_level_index=False)
        if frame is None or frame.empty:
            raise RuntimeError(f"Yahoo returned no prices for {symbol}")
        # Accommodate both normal and MultiIndex layouts.
        if isinstance(frame.columns, pd.MultiIndex):
            frame.columns = frame.columns.get_level_values(0)
        frame = frame.rename(columns=lambda name: str(name).lower())
        frame = frame[["open", "high", "low", "close"]].copy()
        if frame.index.tz is None:
            raise ValueError("Yahoo supplied unzoned timestamps; refusing ambiguous signal timing")
        frame.index = frame.index.tz_convert("America/New_York")
        frame = frame[~frame.index.duplicated(keep="last")].sort_index()
        # Yahoo bars are timestamped when their 5-min candle OPENS.
        # Drop any candle that might still be forming.
        cutoff = pd.Timestamp.now(tz="America/New_York") - pd.Timedelta(seconds=30)
        return frame[frame.index + pd.Timedelta(minutes=5) <= cutoff]

    return one(cfg.es_ticker), one(cfg.nq_ticker)
